# Copy to commute.env (gitignored) to bake your stops into the firmware as
# defaults. Find stop area ids (16 digits, start 9021) with the Västtrafik
# Planera Resa API: GET /pr/v4/locations/by-text?q=<stop name>.
# Every key is optional; the web UI (Commute tab) can set or change them.
COMMUTE_FROM_ID=
COMMUTE_FROM_NAME=
COMMUTE_TO_ID=
COMMUTE_TO_NAME=
COMMUTE_WALK_MIN=0
